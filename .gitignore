# Local datasets (see config/experiment.yaml) — keep empty dir skeleton in git
data/**/*
!data/**/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Heavy result artifacts (structure tracked via .gitkeep)
results/raw/**/*
!results/raw/.gitkeep

# Local detector outputs, downloaded checkpoints and library settings
results/detection/
results/hqgan/
.ultralytics/
Ultralytics/
*.pt

# Generated outputs and local test scratch
results/**/*
!results/**/.gitkeep
.test-tmp/
tmp/
*.cache
